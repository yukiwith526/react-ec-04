{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fleur-lumiere",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "production",
    "ORDER_EMAIL_FROM": "FLEUR LUMIERE <onboarding@resend.dev>"
  },
  "send_email": [
    { "name": "EMAIL" }
  ],
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fleur-lumiere-db",
      "database_id": "1db78329-f3f4-4d72-b5d5-040fe1a6c211",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "fleur-lumiere-media"
    }
  ]
}
